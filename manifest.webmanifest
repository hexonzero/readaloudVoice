{
  "name": "Read Aloud",
  "short_name": "Read Aloud",
  "description": "Listen to documents, web pages and pasted text.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F3F5FB",
  "theme_color": "#5558E3",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}